---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;

const nav = [
  { href: "/", label: "新着" },
  { href: "/hot/", label: "Hot" },
  { href: "/sources/", label: "ソース" },
  { href: "/archive/1/", label: "アーカイブ" },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Tech企業ブログ・個人ブログ・話題の記事を日英横断でまとめるキュレーションサイト" />
    <link rel="alternate" type="application/rss+xml" title="curation.fyi" href="/feed.xml" />
  </head>
  <body class="bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-4xl flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-4">
        <a href="/" class="text-xl font-bold tracking-tight">curation.fyi</a>
        <span class="text-sm text-slate-500">Tech記事キュレーション</span>
        <nav class="ml-auto flex gap-3 text-sm">
          {nav.map((item) => (
            <a
              href={item.href}
              class={
                current === item.href
                  ? "font-semibold text-slate-900"
                  : "text-slate-500 hover:text-slate-900"
              }
            >
              {item.label}
            </a>
          ))}
          <a href="/feed.xml" class="text-slate-500 hover:text-slate-900">RSS</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-4xl px-4 py-6">
      <slot />
    </main>
    <footer class="mx-auto max-w-4xl px-4 py-8 text-sm text-slate-400">
      Updated automatically every 6 hours.
    </footer>
  </body>
</html>
