---
interface Props {
  /** 末尾スラッシュ込みの基底パス。例: /archive/ */
  base: string;
  current: number;
  total: number;
}
const { base, current, total } = Astro.props;

// 現在ページの前後2ページ＋先頭・末尾だけ出す（アーカイブは150ページを超えるため）
const window = new Set<number>([1, total, current - 2, current - 1, current, current + 1, current + 2]);
const pages = [...window].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
---

{
  total > 1 && (
    <nav class="mt-6 flex flex-wrap items-center gap-1 text-sm" aria-label="ページ送り">
      {current > 1 && (
        <a href={`${base}${current - 1}/`} class="rounded border border-slate-200 bg-white px-2 py-1 hover:bg-slate-100">
          前へ
        </a>
      )}
      {pages.map((p, i) => (
        <>
          {i > 0 && pages[i - 1] !== undefined && p - pages[i - 1]! > 1 && (
            <span class="px-1 text-slate-400">…</span>
          )}
          {p === current ? (
            <span class="rounded border border-slate-900 bg-slate-900 px-2 py-1 text-white">{p}</span>
          ) : (
            <a href={`${base}${p}/`} class="rounded border border-slate-200 bg-white px-2 py-1 hover:bg-slate-100">
              {p}
            </a>
          )}
        </>
      ))}
      {current < total && (
        <a href={`${base}${current + 1}/`} class="rounded border border-slate-200 bg-white px-2 py-1 hover:bg-slate-100">
          次へ
        </a>
      )}
    </nav>
  )
}
