---
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/url";
import { loadArticles, loadEnabledSources } from "../../lib/load-articles";

const articles = loadArticles();
const counts = new Map<string, number>();
for (const a of articles) counts.set(a.source_id, (counts.get(a.source_id) ?? 0) + 1);

const TYPE_LABEL: Record<string, string> = {
  company_blog: "企業ブログ",
  personal_blog: "個人ブログ",
  aggregator: "アグリゲータ",
  magazine: "技術誌",
  paper: "論文",
  tweet: "ツイート",
};

const sources = loadEnabledSources()
  .map((s) => ({ ...s, count: counts.get(s.id) ?? 0 }))
  .sort((a, b) => b.count - a.count);
---

<Base title="ソース一覧 — curation.fyi">
  <h1 class="mb-1 text-lg font-bold">ソース一覧</h1>
  <p class="mb-4 text-sm text-slate-500">収集中のソース {sources.length} 件</p>
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="border-b border-slate-200 text-left text-xs uppercase text-slate-500">
        <tr>
          <th class="px-4 py-2 font-medium">名前</th>
          <th class="px-4 py-2 font-medium">種別</th>
          <th class="px-4 py-2 text-right font-medium">記事数</th>
        </tr>
      </thead>
      <tbody>
        {sources.map((s) => (
          <tr class="border-b border-slate-100 last:border-0">
            <td class="px-4 py-2">
              <a href={href(`/sources/${s.id}/1/`)} class="font-medium hover:underline">{s.name}</a>
            </td>
            <td class="px-4 py-2 text-slate-500">{TYPE_LABEL[s.type] ?? s.type}</td>
            <td class="px-4 py-2 text-right tabular-nums text-slate-600">{s.count}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
