---
import type { GetStaticPaths } from "astro";
import type { Article } from "@curation-fyi/shared";
import { href } from "../../lib/url";
import {
  displaySummaryLines,
  displayTags,
  displayTitle,
  loadArticles,
  loadSourceMap,
  loadTagMap,
} from "../../lib/load-articles";

/**
 * Pagefind に「1ページ1記事」でインデックスさせるためだけの薄いページ。
 * 検索結果のリンク先は data-pagefind-meta の url（＝記事の原文URL）に差し替わるので、
 * 利用者がここへ来ることは通常ない。サイト内からもリンクしない。
 * noindex を出して検索エンジンには載せない。
 */
export const getStaticPaths: GetStaticPaths = () => {
  const sourceMap = loadSourceMap();
  const tagMap = loadTagMap();
  return loadArticles().map((article) => ({
    params: { id: article.id },
    props: {
      article,
      sourceName: sourceMap.get(article.source_id)?.name ?? article.source_id,
      tagNames: displayTags(article).map((slug) => tagMap.get(slug)?.name ?? slug),
    },
  }));
};

type Props = { article: Article; sourceName: string; tagNames: string[] };
const { article, sourceName, tagNames } = Astro.props;
const date = article.published_at.slice(0, 10);
// 和訳も索引に載せる。載せないと日本語で検索しても英語記事が引けない。
// 原題と原文の要約も残すので、英語の語からも従来どおり引ける
const title = displayTitle(article);
const summaryLines = displaySummaryLines(article);

// lang はサイトと同じ ja に固定する。記事ごとの言語にすると Pagefind が ja/en の
// 2インデックスを作り、lang="ja" の /search/ からは ja しか引けない
// （実測: Cloudflare が 43件中13件しか出なかった）。単一インデックスで日英まとめて引く
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{article.title}</title>
  </head>
  <body>
    <main data-pagefind-body>
      <h1>{title.main}</h1>
      {title.sub && <p>{title.sub}</p>}
      {summaryLines.length > 0 && <p>{summaryLines.join(" ")}</p>}
      {article.summary && <p>{article.summary}</p>}
      <p>{sourceName} · {date} · {article.language}{tagNames.length > 0 && ` · ${tagNames.join(" ")}`}</p>
      <p><a href={article.url} data-pagefind-meta="url[href]">原文を読む</a></p>
      <p><a href={href("/")}>curation.fyi</a></p>
    </main>
  </body>
</html>
