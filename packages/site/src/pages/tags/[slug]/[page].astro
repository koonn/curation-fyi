---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import Pagination from "../../../components/Pagination.astro";
import type { Article } from "@curation-fyi/shared";
import { displayTags, loadArticles, loadSourceMap, loadTagMap, pageEntries } from "../../../lib/load-articles";

export const getStaticPaths: GetStaticPaths = () => {
  const articles = loadArticles();
  const tagMap = loadTagMap();
  return [...tagMap.values()].flatMap((tag) => {
    const list = articles.filter((a) => displayTags(a).includes(tag.slug));
    return pageEntries(list).map((entry) => ({
      params: { slug: tag.slug, page: entry.page },
      props: { items: entry.items, total: entry.total, name: tag.name, count: list.length },
    }));
  });
};

const { slug } = Astro.params;
type Props = { items: Article[]; total: number; name: string; count: number };
const { items, total, name, count } = Astro.props;
const sourceMap = loadSourceMap();
const tagMap = loadTagMap();
const current = Number(Astro.params.page);
---

<Base title={`${name} — curation.fyi`}>
  <h1 class="mb-1 text-lg font-bold">{name}</h1>
  <p class="mb-4 text-sm text-slate-500">{count} 件 · {total} ページ中 {current} ページ目</p>
  {items.length === 0 && <p class="text-slate-500">このタグの記事はまだありません。</p>}
  <div class="flex flex-col gap-3">
    {items.map((article) => (
      <ArticleCard article={article} source={sourceMap.get(article.source_id)} tagMap={tagMap} />
    ))}
  </div>
  <Pagination base={`/tags/${slug}/`} current={current} total={total} />
</Base>
