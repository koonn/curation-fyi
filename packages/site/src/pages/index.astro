---
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { loadArticles, loadSourceMap, loadTagMap } from "../lib/load-articles";

const articles = loadArticles().slice(0, 100);
const sourceMap = loadSourceMap();
const tagMap = loadTagMap();
---

<Base title="curation.fyi — Tech記事キュレーション">
  <h1 class="mb-4 text-lg font-bold">新着記事</h1>
  {articles.length === 0 && <p class="text-slate-500">記事がまだありません。収集をお待ちください。</p>}
  <div class="flex flex-col gap-3">
    {articles.map((article) => (
      <ArticleCard article={article} source={sourceMap.get(article.source_id)} tagMap={tagMap} />
    ))}
  </div>
  <p class="mt-6 text-sm text-slate-500">
    さらに古い記事は <a href="/archive/1/" class="underline">アーカイブ</a> から。
  </p>
</Base>
