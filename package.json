{
  "name": "curation-fyi",
  "private": true,
  "type": "module",
  "scripts": {
    "collect": "pnpm --filter @curation-fyi/pipeline collect",
    "retag": "pnpm --filter @curation-fyi/pipeline retag",
    "dev": "pnpm --filter @curation-fyi/site dev",
    "build": "pnpm --filter @curation-fyi/site build",
    "typecheck": "pnpm -r typecheck",
    "tag-export": "pnpm --filter @curation-fyi/pipeline tag-export",
    "tag-import": "pnpm --filter @curation-fyi/pipeline tag-import",
    "prune-excluded": "pnpm --filter @curation-fyi/pipeline prune-excluded"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/preact": "5.1.5"
  }
}
